# Only these two secrets are requested by Deploy to Cloudflare.
# Generate independent random values and back them up; never commit real keys.
# SESSION_SECRET: 32 random bytes encoded as hex (64 characters).
# ENCRYPTION_KEY: 32 random bytes encoded as base64 (44 characters).
# Create the admin account and configure cloud/notification credentials in the panel.
SESSION_SECRET=""
ENCRYPTION_KEY=""
